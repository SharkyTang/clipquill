{
  "manifest_version": 3,
  "name": "ClipQuill",
  "short_name": "ClipQuill",
  "version": "0.1.5",
  "description": "保存抖音视频，提取、编辑与导出文案。语音识别使用配套本地服务。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "downloads",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://v.douyin.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ClipQuill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
